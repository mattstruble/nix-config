            "defaults": {
              "color": { "mode": "thresholds" },
              "mappings": [],
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
              "unit": "currencyUSD"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
          "id": 203,
          "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto",
            "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
            "textMode": "auto"
          },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "editorMode": "code",
              "expr": "(sum(increase(litellm_input_tokens_metric_total[$__range])) - sum(increase(litellm_input_cached_tokens_metric_total[$__range])))/1e6 * sum(cloud_model_rates{profile=\"$rate_profile\", token_type=\"input\"}) + sum(increase(litellm_input_cached_tokens_metric_total[$__range]))/1e6 * sum(cloud_model_rates{profile=\"$rate_profile\", token_type=\"cached\"}) + sum(increase(litellm_output_tokens_metric_total[$__range]))/1e6 * sum(cloud_model_rates{profile=\"$rate_profile\", token_type=\"output\"})",
              "legendFormat": "",
              "instant": true,
              "refId": "A"
            }
          ]
        },
        {
          "type": "stat",
          "title": "Est. electricity cost ($/day)",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "mappings": [],
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
              "unit": "currencyUSD"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
          "id": 204,
          "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto",
            "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
            "textMode": "auto"
          },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "editorMode": "code",
              "expr": "avg_over_time(sum(DCGM_FI_DEV_POWER_USAGE)[1h:1m]) / 1000 * 24 * $elec_rate",
              "legendFormat": "",
              "instant": true,
              "refId": "A"
            }
