  "schemaVersion": 39,
  "tags": [ "mjolnir" ],
  "templating": {
    "list": [
      {
        "name": "rate_profile",
        "label": "Cloud rate profile",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(cloud_model_rates, profile)",
        "refresh": 1,
        "current": { "text": "glm-5.3", "value": "glm-5.3" },
        "description": "Cloud API pricing profile (per-token-type rates from cloud_model_rates) used to estimate cost avoided. Pick the comparable model you'd otherwise call."
      },
      {
        "name": "elec_rate",
        "label": "Electricity $/kWh",
        "type": "textbox",
        "query": "0.215",
        "current": { "text": "0.215", "value": "0.215" },
        "description": "Electricity price per kWh used to estimate GPU power cost."
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
