    {
      "type": "row",
      "title": "Live inference",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 217,
      "panels": [
        {
          "type": "table",
          "title": "Per-model live status",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": { "defaults": {}, "overrides": [] },
          "gridPos": { "h": 8, "w": 16, "x": 0, "y": 22 },
          "id": 213,
          "options": { "showHeader": true, "footer": { "show": false } },
          "transformations": [
            { "id": "labelsToFields", "options": { "labelNames": [ "requested_model", "metric" ], "mode": "labelsToFields", "renameLabel": "" } },
            { "id": "merge", "options": {} },
            { "id": "pivot", "options": { "row": "requested_model", "column": "metric", "value": "Value", "aggregation": "lastNotNull" } }
          ],
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "editorMode": "code",
              "expr": "label_replace(sum by (requested_model) (increase(litellm_proxy_total_requests_metric_total[$__range])), \"metric\", \"Requests (range)\", \"\", \"\")",
              "legendFormat": "Value",
              "instant": true,
              "refId": "A"
            },
            {
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "editorMode": "code",
              "expr": "label_replace(sum by (requested_model) (increase(litellm_total_tokens_metric_total[$__range])), \"metric\", \"Tokens (range)\", \"\", \"\")",
              "legendFormat": "Value",
              "instant": true,
              "refId": "B"
            },
            {
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "editorMode": "code",
              "expr": "label_replace(histogram_quantile(0.95, sum by (le, requested_model) (rate(litellm_llm_api_time_to_first_token_metric_bucket[5m]))), \"metric\", \"TTFT p95 (s)\", \"\", \"\")",
              "legendFormat": "Value",
              "instant": true,
              "refId": "C"
            },
            {
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "editorMode": "code",
              "expr": "label_replace(histogram_quantile(0.95, sum by (le, requested_model) (rate(litellm_request_total_latency_metric_bucket[5m]))), \"metric\", \"Latency p95 (s)\", \"\", \"\")",
              "legendFormat": "Value",
              "instant": true,
              "refId": "D"
            }
          ]
        },
