          "expr": "100 * (1 - sum(node_filesystem_avail_bytes{node=~\"^$Node$\",fstype!~\"tmpfs|overlay|squashfs\"}) / sum(node_filesystem_size_bytes{node=~\"^$Node$\",fstype!~\"tmpfs|overlay|squashfs\"}))",
