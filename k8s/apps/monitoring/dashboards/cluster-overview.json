          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(node_memory_MemTotal_bytes{node=~\"^$Node$\"} - node_memory_MemAvailable_bytes{node=~\"^$Node$\"}) / sum(node_memory_MemTotal_bytes{node=~\"^$Node$\"}) * 100",
          "refId": "A",
          "range": true
        }
      ]
    },
